# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI assistant (Claude via the Vercel AI SDK)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Database (PostgreSQL), used once products, orders and bookings move to Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ayushmati

# Payments (Razorpay Payment Gateway). Use TEST keys from Dashboard > Account & Settings > API Keys
# with the dashboard in Test Mode: the key id starts with rzp_test_. Live keys are refused unless
# PAYMENTS_ALLOW_LIVE=1 is set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_ALLOW_LIVE=

# Notifications - next milestone
RESEND_API_KEY=
MSG91_AUTH_KEY=
